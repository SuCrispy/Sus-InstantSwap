{
    "schemaVersion": 1,
    "id": "susinstantswap",
    "version": "${version}",
    "name": "Su's Instant Swap",
    "description": "Hold the inventory key to swap items with your hotbar. Coexists with vanilla — short press toggles inventory, long press swaps.",
    "authors": ["Su_Crispy"],
    "contact": {},
    "license": "LGPL-3.0",
    "icon": "assets/susinstantswap/icon.png",
    "environment": "client",
    "entrypoints": {
        "client": ["com.susinstantswap.SusInstantSwapMod"],
        "modmenu": ["com.susinstantswap.client.compat.ModMenuIntegration"]
    },
    "mixins": [
        {
            "config": "susinstantswap.mixins.json",
            "environment": "client"
        }
    ],
    "depends": {
        "fabricloader": ">=0.19.0",
        "minecraft": [">=26.1", "<26.2"],
        "java": ">=25",
        "fabric-api": "*"
    },
    "suggests": {
        "modmenu": ">=18.0.0-beta.1"
    }
}
